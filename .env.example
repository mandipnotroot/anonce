# Required: HTTPS URL serving this exact build's complete corresponding source.
ANONCE_SOURCE_URL=
# Standard browser HTTPS ports. Keep publication bound to 127.0.0.1 in Compose.
# Browser origins use these standard ports. Zero is reserved for isolated tests.
ANONCE_IDENTITY_PORT=8443
ANONCE_SUBMISSION_PORT=8444
# make up runs the state-owning containers as your non-root UID/GID.
# ANONCE_STATE_DIR=./.browser
